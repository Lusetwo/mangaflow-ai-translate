APP_ENV=local
OCR_PROVIDER=demo
LLM_PROVIDER=demo
# OCR_PROVIDER=rapidocr enables local OCR (model assets may be downloaded on first run).
# LLM_PROVIDER: demo | deepseek | gemini | openai | openai_compat
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
# LLM_HTTP_PROXY=http://127.0.0.1:7897
# 并发翻译请求数，越大越快但可能触发上游限流
TRANSLATION_CONCURRENCY=4
#
# Inpainting: lama (LaMa ONNX) | opencv | demo
INPAINT_PROVIDER=lama
INPAINT_MASK_PADDING=6
# FONT_PATH=C:\Windows\Fonts\msyh.ttc
MAX_IMAGE_BYTES=20971520
MAX_AGENT_STEPS=8
MIN_OCR_CONFIDENCE=0.45
CORS_ORIGINS=http://localhost:5173
